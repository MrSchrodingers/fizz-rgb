{
  "name": "fizz-rgb",
  "private": true,
  "version": "0.3.0",
  "description": "Linux RGB controller for the Redragon Fizz K617 keyboard",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run copy-assets",
    "copy-assets": "mkdir -p packages/core/dist/templates && cp packages/core/src/templates/*.json packages/core/dist/templates/ && chmod +x packages/cli/dist/index.js packages/daemon/dist/index.js",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
