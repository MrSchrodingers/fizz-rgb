{
  "name": "fizz-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "build:appimage": "vite build && electron-builder --linux AppImage --publish never"
  },
  "build": {
    "appId": "br.com.debt.fizz-rgb",
    "productName": "Fizz RGB",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/@fizz/core/dist/**/*",
      "node_modules/@fizz/core/package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "resources/icon.png"
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    }
  },
  "dependencies": {
    "@fizz/core": "*",
    "@hookform/resolvers": "^3.10.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "three": "^0.184.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.0",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
